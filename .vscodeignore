.git/**
.vscode/**
.github/**
.vscode-test/**
src/**
test/**
scripts/**
out/test/**
**/*.map
**/*.ts
*.vsix
multi-shell-mcp-plugin-*.zip
*-portable.zip
*.log
tsconfig.json
eslint.config.mjs
.gitignore
.gitattributes
AGENTS.md
.agents/**
skills-lock.json
plugins/**
node_modules/.cache/**

# The runtime is bundled into dist/extension.js. Development/runtime dependencies
# and individual TypeScript outputs are not needed in the VSIX.
node_modules/**
out/**

# Documentation under docs/ is intentionally bundled with the README so its
# relative links remain valid in both GitHub and the packaged extension.
# Exclude standalone upstream archives. Integrated platform VSIX builds add
# only their verified official tunnel executables and companion files.
tunnel-client-v*/**

# Never distribute project-local AI connector settings or credential-related backups.
.mcp.json
.mcp.json.multishell-backup-*
*.multishell-backup-*
*.multishell-writing-*
*.multishell.lock/**

# Never commit or bundle persistent agent plaintext SQLite memory.
**/*.sqlite
**/*.sqlite-wal
**/*.sqlite-shm
**/*.db
**/*.db-wal
**/*.db-shm