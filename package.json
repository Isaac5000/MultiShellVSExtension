{
  "name": "multi-shell-mcp-server",
  "icon": "media/logo.png",
  "displayName": "MultiShell MCP Server",
  "description": "Multi-window VSCode MCP server with bilingual terminal panel, scoped shells and legacy connector support",
  "version": "0.10.72",
  "publisher": "local-multishell",
  "license": "MIT",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "MultiShell MCP",
      "properties": {
        "multi-shell-mcp.port": {
          "type": "number",
          "default": 3000,
          "minimum": 1024,
          "maximum": 65535,
          "description": "Shared MCP listening port for all VSCode windows. Changing it restarts MultiShell MCP; update external tunnels separately."
        },
        "multi-shell-mcp.defaultEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Whether the MCP server should be enabled by default on VS Code startup"
        },
        "multi-shell-mcp.interactiveAutoExit": {
          "type": "boolean",
          "default": true,
          "description": "%multiShell.interactiveAutoExitDesc%"
        },
        "multi-shell-mcp.globalCodexSkills": {
          "type": "boolean",
          "default": false,
          "description": "Allow connected MCP clients, including remote tunnels, to discover and READ the signed-in OS user's global Codex skills from ~/.agents/skills, ~/.codex/skills and ~/.codex/skills/.system. Off by default for privacy; scripts are never run automatically."
        },
        "multi-shell-mcp.enabledTools": {
          "type": "object",
          "default": {
            "file": true,
            "edit": true,
            "shell": true
          },
          "properties": {
            "file": {
              "type": "boolean",
              "description": "Enable scoped file reading and directory listing tools"
            },
            "edit": {
              "type": "boolean",
              "description": "Enable scoped file creation, modification, copy, move and rename tools"
            },
            "shell": {
              "type": "boolean",
              "description": "Enable shell command execution tools"
            }
          },
          "description": "Configure which MCP tools are enabled"
        }
      }
    },
    "commands": [
      {
        "command": "multi-shell-mcp.toggleServer",
        "title": "%multiShell.toggle%"
      },
      {
        "command": "multi-shell-mcp.showServerInfo",
        "title": "%multiShell.info%"
      },
      {
        "command": "multi-shell-mcp.listSkills",
        "title": "%multiShell.listSkills%"
      },
      {
        "command": "multi-shell-mcp.tunnelInstall",
        "title": "%multiShell.tunnelInstall%"
      },
      {
        "command": "multi-shell-mcp.tunnelConfigure",
        "title": "%multiShell.tunnelConfigure%"
      },
      {
        "command": "multi-shell-mcp.tunnelReuseProfile",
        "title": "%multiShell.tunnelReuseProfile%"
      },
      {
        "command": "multi-shell-mcp.tunnelUpdateKey",
        "title": "%multiShell.tunnelUpdateKey%"
      },
      {
        "command": "multi-shell-mcp.tunnelStart",
        "title": "%multiShell.tunnelStart%"
      },
      {
        "command": "multi-shell-mcp.tunnelStop",
        "title": "%multiShell.tunnelStop%"
      },
      {
        "command": "multi-shell-mcp.tunnelStatus",
        "title": "%multiShell.tunnelStatus%"
      },
      {
        "command": "multi-shell-mcp.tunnelAutoStart",
        "title": "%multiShell.tunnelAutoStart%"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "multi-shell-mcp",
          "title": "%multiShell.container%",
          "icon": "media/multishell.svg"
        }
      ]
    },
    "views": {
      "multi-shell-mcp": [
        {
          "id": "multi-shell-mcp.sessions",
          "name": "%multiShell.sessions%",
          "type": "webview",
          "icon": "media/multishell.svg"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "compile": "node scripts/clean-out.cjs && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src media/panel.js --max-warnings 0",
    "test": "npm run test:multishell",
    "test:vscode": "node scripts/run-vscode-terminal-tests.cjs",
    "test:connection": "node --expose-gc test/connection-soak.cjs",
    "test:windows": "node scripts/run-vscode-connection-tests.cjs",
    "package": "npm run bundle && node scripts/package-platform-tunnel.cjs",
    "package:plugin": "node scripts/package-plugin.cjs",
    "package:all": "npm run package && npm run package:plugin",
    "test:multishell": "npm run compile && node scripts/bundle.cjs && node scripts/run-tests.cjs",
    "test:batch": "node scripts/run-tests.cjs",
    "test:panel": "node test/test-panel.cjs && node test/test-panel-layout.cjs",
    "bundle": "npm run compile && node scripts/bundle.cjs",
    "storage:cleanup": "node scripts/storage-maintenance.cjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/express": "^4.17.21",
    "@types/node": "20.x",
    "@types/vscode": "^1.99.0",
    "@types/yauzl": "^3.4.0",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "proxyquire": "^2.1.3",
    "typescript": "^5.8.2",
    "yazl": "^2.5.1"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "express": "^4.18.3",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "MultiShell MCP Server executes shell commands and reads or edits workspace files through MCP. Trust the workspace before starting the server."
    }
  }
}
