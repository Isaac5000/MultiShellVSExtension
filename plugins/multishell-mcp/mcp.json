{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "multishell": {
      "type": "streamable-http",
      "url": "http://127.0.0.1:3000/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "api_key",
            "headerScheme": "custom_header",
            "headerName": "X-MultiShell-Local-Auth"
          }
        }
      }
    }
  }
}
